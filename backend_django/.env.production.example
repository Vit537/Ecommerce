# Configuración para Producción (Cloud Run)
# IMPORTANTE: Estas variables deben configurarse en Cloud Run, NO en un archivo .env

# Django
DEBUG=False
DJANGO_SECRET_KEY=<CAMBIAR-POR-KEY-SEGURA>
ALLOWED_HOSTS=*

# Database (Cloud SQL)
DB_NAME=<tu-database-name>
DB_USER=<tu-database-user>
DB_PASSWORD=<tu-database-password>
DB_HOST=/cloudsql/<PROJECT-ID>:<REGION>:<INSTANCE-NAME>
DB_PORT=5432
CLOUD_SQL_CONNECTION_NAME=<PROJECT-ID>:<REGION>:<INSTANCE-NAME>

# Google Cloud Storage
USE_CLOUD_STORAGE=True
GS_BUCKET_NAME=ecommerce-media-storage
GCP_PROJECT_ID=big-axiom-474503-m5

# NO configurar GOOGLE_APPLICATION_CREDENTIALS en Cloud Run
# Las credenciales se obtienen automáticamente del metadata server

# Otros (si aplican)
GROQ_API_KEY=<tu-groq-api-key>
STRIPE_SECRET_KEY=<tu-stripe-secret-key>
STRIPE_PUBLISHABLE_KEY=<tu-stripe-publishable-key>
STRIPE_WEBHOOK_SECRET=<tu-stripe-webhook-secret>
